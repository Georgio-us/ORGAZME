# Railway injects this automatically when a PostgreSQL service is linked.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orgazme

# Added when the AI ingestion endpoint is connected.
OPENAI_API_KEY=

# Optional model overrides. Defaults are production-ready.
# Короткие однозначные команды
OPENAI_FAST_MODEL=gpt-5.6-terra
# Длинные, составные и финансовые голосовые сообщения
OPENAI_COMPLEX_MODEL=gpt-5.6-sol
# Контекстный диалог внутри клиента
OPENAI_CHAT_MODEL=gpt-5.6-terra
# Legacy fallback for the fast route
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
