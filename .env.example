# Railway injects this automatically when a PostgreSQL service is linked.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orgazme

# Added when the AI ingestion endpoint is connected.
OPENAI_API_KEY=

# Optional model overrides. Defaults are production-ready.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
